---
import { Picture, getImage } from 'astro:assets';
import { site } from '../content/site';
import { gallery } from '../content/gallery';

const full = await Promise.all(
  gallery.map((p) => getImage({ src: p.src, format: 'webp', width: p.src.width, quality: 85 })),
);
const fullAfter = await Promise.all(
  gallery.map((p) => (p.after ? getImage({ src: p.after, format: 'webp', width: p.after.width, quality: 85 }) : undefined)),
);
---
<section id="galeria" aria-labelledby="galeria-titulo">
  <h2 id="galeria-titulo">{site.sections.gallery}</h2>
  <p class="intro">{site.galleryText}</p>
  <ul class="grid">
    {gallery.map((photo, i) => (
      <li class:list={['cell', `c${i + 1}`, { 'has-after': !!photo.after }]} style={`--ar:${photo.src.width}/${photo.src.height}`}>
        <button type="button" data-open={i} data-full={full[i].src} data-after={fullAfter[i]?.src} data-alt={photo.alt} aria-label={`Ampliar foto ${i + 1} de ${gallery.length}`}>
          <Picture
            src={photo.src}
            alt={photo.alt}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            widths={[400, 600]}
            sizes="(min-width: 900px) 40vw, 50vw"
            loading="lazy"
            decoding="async"
          />
          {photo.after && (
            <span class="after" aria-hidden="true">
              <Picture src={photo.after} alt="" formats={['avif', 'webp']} fallbackFormat="jpeg" widths={[400, 600]} sizes="(min-width: 900px) 40vw, 50vw" loading="lazy" decoding="async" />
              <span class="tag">Nelson</span>
            </span>
          )}
        </button>
      </li>
    ))}
  </ul>

  <dialog class="lightbox" aria-label="Galería ampliada">
    <button type="button" class="lb-close" data-close aria-label="Cerrar">Cerrar</button>
    <button type="button" class="lb-toggle" data-toggle hidden>Ver a Nelson</button>
    <button type="button" class="lb-nav lb-prev" data-step="-1" aria-label="Foto anterior">Anterior</button>
    <button type="button" class="lb-nav lb-next" data-step="1" aria-label="Foto siguiente">Siguiente</button>
    <p class="lb-count" aria-live="polite"></p>
  </dialog>
</section>

<style>
  .intro { max-width: var(--measure); margin-top: 1.5rem; color: var(--bone-dim); }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; margin-top: clamp(1.5rem, 4vw, 2.5rem); max-width: 90rem; }
  .cell { aspect-ratio: 4 / 3; overflow: hidden; background: var(--ink-2); }
  .cell.c9 { grid-column: span 2; aspect-ratio: 16 / 7; }
  .cell button { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .cell :global(img) { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.82) contrast(1.05); transition: filter 0.6s var(--ease-out), transform 0.9s var(--ease-out); }
  .cell button:hover :global(img), .cell button:focus-visible :global(img) { filter: brightness(1) contrast(1.05); transform: scale(1.03); }
  @media (min-width: 900px) {
    .grid { grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
    .cell.c5, .cell.c8, .cell.c9 { grid-column: span 2; aspect-ratio: 8 / 3; }
    .cell.c8, .cell.c9 { aspect-ratio: 8 / 3; }
  }

  .lightbox {
    width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0;
    background: color-mix(in srgb, var(--ink) 96%, transparent); color: var(--bone);
  }
  .lightbox::backdrop { background: var(--ink); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox img { max-width: min(92vw, 1400px); max-height: 82dvh; width: auto; height: auto; object-fit: contain; }
  .lightbox button {
    position: absolute; padding: 0.875rem 1.25rem; border: 1px solid var(--rule); background: var(--ink);
    color: var(--bone); font: inherit; font-size: var(--step-small); font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer;
  }
  .lightbox button:hover { border-color: var(--curtain-lit); }

  /* Chiche antes/después (features.beforeAfter): borrar este bloque + .after en el markup = revertir. */
  .cell button { position: relative; }
  .after { position: absolute; inset: 0; opacity: 0; transition: opacity 0.45s var(--ease-out); pointer-events: none; }
  .after :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%; filter: contrast(1.05); }
  .tag { position: absolute; left: 0.5rem; bottom: 0.5rem; padding: 0.25rem 0.5rem; background: var(--ink); color: var(--bone); font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; }
  @media (hover: hover) {
    .has-after button:hover .after, .has-after button:focus-visible .after { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .after { transition: none; } }
  .lb-toggle { top: 1rem; left: 1rem; }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-nav { bottom: 1.25rem; }
  .lb-prev { left: 1rem; }
  .lb-next { right: 1rem; }
  .lb-count { position: absolute; bottom: 2rem; left: 0; right: 0; text-align: center; font-size: var(--step-small); letter-spacing: 0.2em; color: var(--bone-dim); }
  @media (min-width: 900px) {
    .lb-nav { top: 50%; bottom: auto; transform: translateY(-50%); }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cell { animation: reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 55%; }
      @keyframes reveal { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
    }
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dlg) {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-open]')];
    const img = document.createElement('img');
    dlg.prepend(img);
    const count = dlg.querySelector<HTMLElement>('.lb-count')!;
    const toggle = dlg.querySelector<HTMLButtonElement>('[data-toggle]')!;
    let index = 0;
    let showAfter = false;

    const show = (i: number, after = false) => {
      index = (i + buttons.length) % buttons.length;
      const b = buttons[index];
      showAfter = after && !!b.dataset.after;
      toggle.hidden = !b.dataset.after;
      toggle.textContent = showAfter ? 'Ver personaje' : 'Ver a Nelson';
      img.src = showAfter ? b.dataset.after! : b.dataset.full!;
      img.alt = b.dataset.alt ?? '';
      count.textContent = `${index + 1} / ${buttons.length}`;
    };

    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        show(i);
        dlg.showModal();
      }),
    );

    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-close]') || t === dlg || t === img) dlg.close();
      if (t.closest('[data-toggle]')) show(index, !showAfter);
      const step = t.closest<HTMLElement>('[data-step]');
      if (step) show(index + Number(step.dataset.step));
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
  }
</script>
