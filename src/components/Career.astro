---
import { site } from '../content/site';
import { career } from '../content/bio';
---
<section id="trayectoria" aria-labelledby="trayectoria-titulo">
  <div class="wrap">
    <h2 id="trayectoria-titulo">{site.sections.career}</h2>

    {career.map((block) => (
      <article class="block" id={block.id}>
        <header>
          <h3>{block.title}</h3>
        </header>
        <div class="body">
          {block.paragraphs.map((p) => <p set:html={p} />)}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .wrap { max-width: 90rem; margin-inline: auto; }
  h2 { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .block { display: grid; gap: 1.5rem; padding-block: 2.5rem; border-top: 1px solid var(--rule); }
  h3, h4 { font-family: var(--font-display); font-stretch: 70%; text-transform: uppercase; font-weight: 800; line-height: 1; }
  h3 { font-size: var(--step-h3); }
  .body { display: grid; gap: 1.1rem; max-width: var(--measure); align-content: start; }
  .body p { color: var(--bone); text-wrap: pretty; }
  .body :global(strong) { font-weight: 650; }

  /* Listas como créditos: filetes finos, tipografía display */
  .credits { border-top: 1px solid var(--rule); margin-block: 0.25rem; }
  .credits li {
    padding: 0.7rem 0; border-bottom: 1px solid var(--rule); color: var(--bone-dim);
    font-size: 1rem;
  }
  .credits li :global(strong) {
    font-family: var(--font-display); font-stretch: 70%; text-transform: uppercase; font-weight: 700;
    font-size: 1.35rem; letter-spacing: 0.02em; color: var(--bone); margin-right: 0.35em;
  }

  .items { display: grid; gap: 0; border-top: 1px solid var(--rule); }
  .item { padding-block: 1.1rem; border-bottom: 1px solid var(--rule); }
  h4 { font-size: 1.5rem; margin-bottom: 0.5rem; color: var(--bone); }
  .item p { font-size: 1rem; color: var(--bone-dim); }
  .item p :global(strong) { color: var(--bone); }

  @media (min-width: 900px) {
    .block { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 3rem; padding-block: 3rem; }
    header { position: sticky; top: calc(var(--header-h) + 1.5rem); align-self: start; }
    .credits { display: grid; grid-template-columns: 1fr 1fr; column-gap: 2rem; }
    .body { max-width: 52rem; }
  }
</style>
