---
import { site } from '../content/site';
import { intro, about } from '../content/bio';
---
<section id="biografia" aria-labelledby="biografia-titulo">
  <div class="wrap">
    <h2 id="biografia-titulo">{site.sections.bio}</h2>

    <div class="lead">
      <p class="big" set:html={intro[0]} />
      <p class="sub" set:html={intro[1]} />
    </div>

    {about.map((sec) => (
      <article class="about">
        <h3>{sec.title}</h3>
        <div class="prose">
          {sec.paragraphs.map((p) => <p set:html={p} />)}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .wrap { max-width: 90rem; margin-inline: auto; }
  h2 { margin-bottom: 3rem; }
  p { color: var(--bone); text-wrap: pretty; }
  p :global(strong) { font-weight: 650; }

  .lead { max-width: 62rem; margin-bottom: 3rem; }
  .big {
    font-family: var(--font-display); font-stretch: 85%; font-weight: 600;
    font-size: clamp(1.6rem, 3.4vw, 3rem); line-height: 1.2; letter-spacing: -0.005em;
  }
  .big :global(strong) { font-weight: 800; }
  .prose :global(a) {
    text-decoration: underline; text-decoration-color: var(--curtain-lit); text-decoration-thickness: 2px;
    text-underline-offset: 0.25em; transition: text-underline-offset 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .prose :global(a:hover) { text-underline-offset: 0.12em; color: var(--curtain-lit); }
  .sub { margin-top: 1.5rem; max-width: var(--measure); color: var(--bone-dim); }

  .about { padding-block: 2rem; border-top: 1px solid var(--rule); display: grid; gap: 1.25rem; }
  h3 { font-family: var(--font-display); font-stretch: 70%; text-transform: uppercase; font-weight: 800; line-height: 1; font-size: var(--step-h3); }
  .prose { display: grid; gap: 1rem; max-width: var(--measure); }
  @media (min-width: 900px) {
    .about { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 3rem; }
  }
</style>
