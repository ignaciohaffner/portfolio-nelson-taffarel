---
import { site } from '../content/site';
import { bio } from '../content/bio';
const [about, ...rest] = bio;
---
<section id="biografia" aria-labelledby="biografia-titulo">
  <div class="wrap">
    <h2 id="biografia-titulo">{site.sections.bio}</h2>

    <article class="lead">
      <h3>{about.title}</h3>
      <p set:html={about.html} />
    </article>

    <div class="cols">
      {rest.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p set:html={item.html} />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .wrap { max-width: 90rem; margin-inline: auto; }
  h2 { margin-bottom: 3rem; }
  p { color: var(--bone); text-wrap: pretty; }
  p :global(strong) { font-weight: 650; }
  /* Obras y programas como créditos: mismo texto, otra tipografía */
  p :global(em) {
    font-family: var(--font-display); font-stretch: 70%; text-transform: uppercase;
    font-style: normal; font-weight: 700; letter-spacing: 0.03em;
  }
  h3 { font-family: var(--font-display); font-stretch: 70%; text-transform: uppercase; font-weight: 800; line-height: 1; }

  .lead { max-width: 60rem; margin-bottom: 4rem; }
  .lead h3 {
    font-family: var(--font-text); font-stretch: 100%; font-size: var(--step-small); font-weight: 700;
    letter-spacing: 0.3em; color: var(--curtain-lit); margin-bottom: 1.25rem;
  }
  .lead p {
    font-family: var(--font-display); font-stretch: 85%; font-weight: 600; text-transform: none;
    font-size: clamp(1.6rem, 3.4vw, 3rem); line-height: 1.2; letter-spacing: -0.005em;
  }
  .lead p :global(strong) { font-weight: 800; }

  .cols { display: grid; gap: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--rule); }
  .cols h3 { font-size: var(--step-h3); margin-bottom: 0.75rem; }
  .cols p { font-size: 1.0625rem; line-height: 1.6; }
  @media (min-width: 900px) { .cols { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      article { animation: item-in linear both; animation-timeline: view(); animation-range: entry 5% entry 45%; }
      @keyframes item-in { from { opacity: 0; transform: translateY(2rem); } }
    }
  }
</style>
