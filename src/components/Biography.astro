---
import { site } from '../content/site';
import { intro } from '../content/bio';
---
<section id="biografia" aria-labelledby="biografia-titulo">
  <div class="wrap">
    <!-- Título visualmente oculto: Nelson pidió sacarlo de pantalla, pero se mantiene en el HTML
         para el <h2> de la sección (SEO/estructura) y como ancla del menú. -->
    <h2 id="biografia-titulo" class="sr-only">{site.sections.bio}</h2>

    <div class="lead">
      <p class="big" set:html={intro[0]} />
    </div>
  </div>
</section>

<style>
  .wrap { max-width: 90rem; margin-inline: auto; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
  }
  p { color: var(--bone); text-wrap: pretty; }
  p :global(strong) { font-weight: 650; }

  .lead { max-width: 62rem; }
  .big {
    font-family: var(--font-display); font-stretch: 85%; font-weight: 600;
    font-size: clamp(1.6rem, 3.4vw, 3rem); line-height: 1.2; letter-spacing: -0.005em;
  }
  .big :global(strong) { font-weight: 800; }
</style>
