---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../content/site';
import { reels } from '../content/reels';

const thumbs = import.meta.glob<{ default: ImageMetadata }>('../assets/reels/*.jpg', { eager: true });
const thumbOf = (id: string) => thumbs[`../assets/reels/${id}.jpg`].default;
const watch = (id: string) => `https://www.youtube.com/watch?v=${id}`;
---
<section id="reels" aria-labelledby="reels-titulo" data-reels>
  <h2 id="reels-titulo">{site.sections.reels}</h2>

  <div class="reel-stage">
    {reels.map((reel, i) => (
      <div class="reel-panel" data-panel={i} data-id={reel.id} data-title={reel.title}>
        <a class="reel-facade" href={watch(reel.id)} rel="noopener" aria-label={`Reproducir ${reel.title}`}>
          <Picture
            src={thumbOf(reel.id)}
            alt=""
            formats={['avif', 'webp']}
            widths={[480, 960]}
            sizes="(min-width: 900px) 70vw, 100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <span class="reel-play" aria-hidden="true"></span>
        </a>
      </div>
    ))}
  </div>

  <ol class="reel-list">
    {reels.map((reel, i) => (
      <li>
        <a href={watch(reel.id)} rel="noopener" data-track={i} aria-current={i === 0 ? 'true' : undefined}>
          {reel.title}
        </a>
      </li>
    ))}
  </ol>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-reels]');
  if (root) {
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const tracks = [...root.querySelectorAll<HTMLAnchorElement>('[data-track]')];
    const facades = new Map(panels.map((p) => [p, p.innerHTML]));

    const show = (index: number) => {
      panels.forEach((p, i) => {
        p.hidden = i !== index;
        // Al cambiar de reel se vuelve al facade (se descarta el iframe).
        if (i !== index && p.querySelector('iframe')) p.innerHTML = facades.get(p)!;
      });
      tracks.forEach((t, i) => (i === index ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    };

    const play = (panel: HTMLElement) => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${panel.dataset.id}?autoplay=1&rel=0`;
      iframe.title = panel.dataset.title ?? 'Reel';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      panel.replaceChildren(iframe);
    };

    show(0);

    root.addEventListener('click', (e) => {
      const target = e.target as Element;
      const track = target.closest<HTMLAnchorElement>('[data-track]');
      if (track) {
        e.preventDefault();
        show(Number(track.dataset.track));
        return;
      }
      const facade = target.closest<HTMLAnchorElement>('.reel-facade');
      if (facade) {
        e.preventDefault();
        play(facade.closest<HTMLElement>('[data-panel]')!);
      }
    });
  }
</script>
