---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../content/site';
import { reels } from '../content/reels';

const thumbs = import.meta.glob<{ default: ImageMetadata }>('../assets/reels/*.jpg', { eager: true });
const thumbOf = (id: string) => thumbs[`../assets/reels/${id}.jpg`].default;
const watch = (id: string) => `https://www.youtube.com/watch?v=${id}`;
---
<section id="reels" aria-labelledby="reels-titulo" data-reels>
  <h2 id="reels-titulo">{site.sections.reels}</h2>

  <div class="wrap">
  <div class="reel-stage">
    {reels.map((reel, i) => (
      <div class="reel-panel" data-panel={i} data-id={reel.id} data-title={reel.title}>
        <a class="reel-facade" href={watch(reel.id)} rel="noopener" aria-label={`Reproducir ${reel.title}`}>
          <Picture
            src={thumbOf(reel.id)}
            alt=""
            formats={['avif', 'webp']}
            widths={[480, 960]}
            sizes="(min-width: 900px) 70vw, 100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <span class="reel-play" aria-hidden="true"></span>
        </a>
      </div>
    ))}
  </div>

  <ol class="reel-list">
    {reels.map((reel, i) => (
      <li>
        <a href={watch(reel.id)} rel="noopener" data-track={i} aria-current={i === 0 ? 'true' : undefined}>
          {reel.title}
        </a>
      </li>
    ))}
  </ol>
  </div>
</section>
<style>
  .wrap { max-width: 90rem; margin-inline: auto; display: grid; gap: 2.5rem; margin-top: clamp(2.5rem, 6vw, 4.5rem); }
  .reel-stage { position: relative; aspect-ratio: 16 / 9; background: var(--ink-2); }
  .reel-panel, .reel-facade { position: absolute; inset: 0; display: block; }
  .reel-panel[hidden] { display: none; }
  .reel-panel :global(iframe) { width: 100%; height: 100%; border: 0; }
  .reel-facade :global(img) { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.75); transition: filter 0.5s var(--ease-out); }
  .reel-facade:hover :global(img) { filter: brightness(0.95); }
  .reel-play {
    position: absolute; left: 50%; top: 50%; width: clamp(4.5rem, 10vw, 6.5rem); aspect-ratio: 1;
    translate: -50% -50%; border-radius: 50%; background: var(--curtain);
    transition: scale 0.4s var(--ease-out);
  }
  .reel-play::after {
    content: ''; position: absolute; left: 54%; top: 50%; translate: -50% -50%;
    border-style: solid; border-width: 0.9rem 0 0.9rem 1.5rem; border-color: transparent transparent transparent var(--bone);
  }
  .reel-facade:hover .reel-play { scale: 1.08; }
  .reel-list { counter-reset: track; border-top: 1px solid var(--rule); align-self: start; }
  .reel-list li { counter-increment: track; border-bottom: 1px solid var(--rule); }
  .reel-list a {
    display: flex; align-items: baseline; gap: 1.25rem; padding: 1.1rem 0; text-decoration: none;
    font-family: var(--font-display); font-stretch: 70%; text-transform: uppercase; font-weight: 600; font-size: var(--step-h3); line-height: 1.1; color: var(--bone-dim);
    transition: color 0.3s var(--ease-out);
  }
  .reel-list a::before {
    content: counter(track, decimal-leading-zero); min-width: 2.25rem;
    font-family: var(--font-text); font-size: var(--step-small); font-weight: 600; letter-spacing: 0.2em; color: var(--bone-dim);
  }
  .reel-list a:hover { color: var(--bone); }
  .reel-list a[aria-current] { color: var(--bone); }
  .reel-list a[aria-current]::after { content: ''; width: 0.6rem; height: 0.6rem; margin-left: auto; align-self: center; background: var(--curtain); border-radius: 50%; }
  @media (min-width: 900px) {
    .wrap { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 4rem; }
  }
</style>


<script>
  const root = document.querySelector<HTMLElement>('[data-reels]');
  if (root) {
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const tracks = [...root.querySelectorAll<HTMLAnchorElement>('[data-track]')];
    const facades = new Map(panels.map((p) => [p, p.innerHTML]));

    const show = (index: number) => {
      panels.forEach((p, i) => {
        p.hidden = i !== index;
        // Al cambiar de reel se vuelve al facade (se descarta el iframe).
        if (i !== index && p.querySelector('iframe')) p.innerHTML = facades.get(p)!;
      });
      tracks.forEach((t, i) => (i === index ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    };

    const play = (panel: HTMLElement) => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${panel.dataset.id}?autoplay=1&rel=0`;
      iframe.title = panel.dataset.title ?? 'Reel';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      panel.replaceChildren(iframe);
    };

    show(0);

    root.addEventListener('click', (e) => {
      const target = e.target as Element;
      const track = target.closest<HTMLAnchorElement>('[data-track]');
      if (track) {
        e.preventDefault();
        show(Number(track.dataset.track));
        return;
      }
      const facade = target.closest<HTMLAnchorElement>('.reel-facade');
      if (facade) {
        e.preventDefault();
        play(facade.closest<HTMLElement>('[data-panel]')!);
      }
    });
  }
</script>
