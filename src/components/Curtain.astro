---
// Chiche: telón que se abre al cargar (features.curtain). CSS puro, sin JS.
// Se omite con prefers-reduced-motion. Borrar este componente + su uso en index.astro = revertir.
---
<div class="curtain" aria-hidden="true">
  <div class="panel left"></div>
  <div class="panel right"></div>
</div>

<style>
  .curtain { position: fixed; inset: 0; z-index: 200; pointer-events: none; display: none; }
  .panel {
    position: absolute; top: 0; bottom: 0; width: 50.5%;
    /* pliegues del telón: bandas oscuras/claras sobre el rojo */
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.55), transparent 22%, transparent 78%, rgb(0 0 0 / 0.45)),
      repeating-linear-gradient(90deg, #7d1812 0, #b3261e 3.5vw, #d03a30 5vw, #b3261e 6.5vw, #7d1812 9vw);
    box-shadow: 0 0 40px rgb(0 0 0 / 0.6);
  }
  .left { left: 0; transform-origin: left center; }
  .right { right: 0; transform-origin: right center; }

  @media (prefers-reduced-motion: no-preference) {
    .curtain { display: block; animation: gone 0s linear 1.55s forwards; }
    .left { animation: open-left 1.05s cubic-bezier(0.7, 0, 0.2, 1) 0.3s both; }
    .right { animation: open-right 1.05s cubic-bezier(0.7, 0, 0.2, 1) 0.3s both; }
    @keyframes open-left { to { transform: translateX(-102%) scaleX(0.85); } }
    @keyframes open-right { to { transform: translateX(102%) scaleX(0.85); } }
    @keyframes gone { to { visibility: hidden; } }
  }
</style>
