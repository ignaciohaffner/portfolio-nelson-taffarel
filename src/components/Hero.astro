---
import { Picture } from 'astro:assets';
import { site } from '../content/site';
import { heroPhoto } from '../content/gallery';
const [first, ...rest] = site.name.split(' ');
---
<section id="home" class="hero">
  <div class="photo">
    <Picture
      src={heroPhoto.src}
      alt={heroPhoto.alt}
      formats={['avif', 'webp']}
      widths={[480, 640]}
      sizes="(min-width: 900px) 46vw, 100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="copy">
    <h1><span>{first}</span> <span>{rest.join(' ')}</span></h1>
    <p class="roles">{site.rolesLine}</p>
    <p class="place">{site.location}</p>
    <a class="cta" href="#biografia">{site.cta}</a>
  </div>
</section>

<style>
  .hero {
    position: relative; min-height: 100svh; overflow: clip;
    display: grid; align-items: end;
    padding: calc(var(--header-h) + 2rem) var(--gutter) clamp(2.5rem, 6vw, 5rem);
    isolation: isolate;
  }
  .photo { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .photo :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%;
    filter: contrast(1.05) brightness(0.9);
    transform-origin: 50% 30%;
  }
  /* Viñeta: nada de texto sobre foto sin gradiente */
  .photo::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(to top, var(--ink) 4%, color-mix(in srgb, var(--ink) 72%, transparent) 38%, transparent 72%),
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 65%, transparent), transparent 22%);
  }
  h1 {
    font-family: var(--font-display); font-stretch: 70%; text-transform: uppercase; font-weight: 800; font-size: var(--step-hero);
    line-height: 0.84; letter-spacing: -0.01em; text-wrap: balance;
  }
  h1 span { display: block; }
  .roles {
    margin-top: 1.75rem;
    font-size: var(--step-small); font-weight: 600; letter-spacing: 0.32em; text-transform: uppercase;
    color: var(--bone-dim);
  }
  .place { margin-top: 0.6rem; font-size: var(--step-small); letter-spacing: 0.12em; color: var(--bone-dim); }
  .cta {
    display: inline-block; margin-top: 2.25rem; padding: 0.75rem 0;
    font-size: 0.9375rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
    text-decoration: underline; text-decoration-color: var(--curtain-lit); text-decoration-thickness: 3px;
    text-underline-offset: 0.7em; transition: text-underline-offset 0.4s var(--ease-out);
  }
  .cta:hover { text-underline-offset: 0.35em; }

  /* Desktop: retrato a la derecha (la fuente es 640 px de ancho: no se estira a sangre completa) */
  @media (min-width: 900px) {
    .photo { left: auto; width: min(46vw, 640px); }
    .photo::after {
      background:
        linear-gradient(to right, var(--ink) 0%, color-mix(in srgb, var(--ink) 55%, transparent) 10%, transparent 34%),
        linear-gradient(to top, var(--ink), transparent 30%);
    }
    .copy { position: relative; }
    
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo :global(img) { animation: drift 20s linear both; }
    @keyframes drift { from { transform: scale(1); } to { transform: scale(1.07); } }
    h1 span { animation: rise 1.1s var(--ease-out) both; }
    h1 span:last-child { animation-delay: 0.12s; }
    .roles, .place, .cta { animation: fade 1s var(--ease-out) 0.5s both; }
    @keyframes rise { from { opacity: 0; transform: translateY(0.35em); } }
    @keyframes fade { from { opacity: 0; } }
  }
</style>
