---
import { site } from '../content/site';
---
<section id="contacto" aria-labelledby="contacto-titulo">
  <div class="end">
    <h2 id="contacto-titulo">{site.sections.contact}</h2>
    <p class="text">{site.contactText}</p>
    <address>
      <strong>{site.alternateName}</strong>
      <span>{site.rolesLine}</span>
      <span>{site.location}, Argentina</span>
    </address>
    <ul>
      <li><a href={site.links.instagram} target="_blank" rel="noopener">Instagram</a></li>
      <li><a href={site.links.vimeo} target="_blank" rel="noopener">Vimeo</a></li>
    </ul>
    <section class="press" aria-labelledby="prensa-titulo">
      <h3 id="prensa-titulo">Bio breve</h3>
      <p>{site.shortBio}</p>
    </section>
  </div>
</section>

<style>
  .end { max-width: 90rem; margin-inline: auto; padding-top: clamp(2.5rem, 6vw, 5rem); border-top: 1px solid var(--rule); }
  .text { max-width: var(--measure); margin-top: 1.5rem; color: var(--bone); }
  address { margin-top: 2rem; font-style: normal; display: grid; gap: 0.25rem; color: var(--bone-dim); }
  address strong {
    font-family: var(--font-display); font-stretch: 70%; text-transform: uppercase; font-weight: 800;
    font-size: 1.75rem; color: var(--bone); letter-spacing: 0.01em;
  }
  .press { margin-top: clamp(2.5rem, 6vw, 4.5rem); padding-top: 1.5rem; border-top: 1px solid var(--rule); max-width: 46rem; }
  .press h3 { font-family: var(--font-text); font-size: var(--step-small); font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; color: var(--curtain-lit); margin-bottom: 0.75rem; }
  .press p { color: var(--bone-dim); font-size: 1rem; }
  ul { margin-top: clamp(1.5rem, 4vw, 3rem); display: grid; gap: 0.25rem; }
  a {
    display: inline-block; padding-block: 0.25rem;
    font-family: var(--font-display); font-stretch: 70%; text-transform: uppercase; font-weight: 800;
    font-size: clamp(3rem, 11vw, 8.5rem); line-height: 1; letter-spacing: -0.01em;
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 0.06em; text-underline-offset: 0.12em;
    transition: text-decoration-color 0.4s var(--ease-out);
  }
  a:hover { text-decoration-color: var(--curtain-lit); }
</style>
