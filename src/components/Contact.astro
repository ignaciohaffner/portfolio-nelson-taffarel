---
import { site } from '../content/site';
---
<section id="contacto" aria-labelledby="contacto-titulo">
  <div class="end">
    <h2 id="contacto-titulo">{site.sections.contact}</h2>
    <ul>
      <li><a href={site.links.instagram} target="_blank" rel="noopener">@neltaffarel</a></li>
    </ul>
    <p class="mail"><a href={`mailto:${site.mail}`}>{site.mail}</a></p>
    <p class="thanks">Gracias por mirarlo.</p>
  </div>
</section>

<style>
  .end { max-width: 90rem; margin-inline: auto; padding-top: clamp(2.5rem, 6vw, 5rem); border-top: 1px solid var(--rule); }
  ul { margin-top: 1.5rem; display: grid; gap: 0.25rem; }
  a {
    display: inline-block; padding-block: 0.25rem;
    font-family: var(--font-display); font-stretch: 70%; text-transform: uppercase; font-weight: 800;
    font-size: clamp(1.25rem, 2.5vw, 1.875rem); line-height: 1; letter-spacing: 0.01em;
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 0.06em; text-underline-offset: 0.15em;
    transition: text-decoration-color 0.4s var(--ease-out);
  }
  a:hover { text-decoration-color: var(--curtain-lit); }

  /* El mail no entra en el mismo tamaño gigante que Instagram: tipografía de texto, no de afiche */
  .mail { margin-top: 0.25rem; }
  .mail a {
    font-family: var(--font-text); font-stretch: 100%; font-weight: 600; text-transform: none;
    font-size: clamp(1rem, 2vw, 1.25rem); letter-spacing: 0.01em;
    color: var(--bone-dim); padding-top: 0; text-decoration-color: var(--rule); word-break: break-all;
  }
  .mail a:hover { color: var(--bone); }
  .thanks { margin-top: 2.25rem; color: var(--bone-dim); font-size: 1rem; }
</style>
