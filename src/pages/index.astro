---
import { features } from '../content/site';
import SideNav from '../components/SideNav.astro';
import BackToTop from '../components/BackToTop.astro';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Biography from '../components/Biography.astro';
import Career from '../components/Career.astro';
import Gallery from '../components/Gallery.astro';
import Reels from '../components/Reels.astro';
import Contact from '../components/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Base>
  <a class="skip-link" href="#biografia">Saltar al contenido</a>
  <SiteHeader />
  <main>
    <Hero />
    <Biography />
    <Career />
    <Reels />
    <Gallery />
    <Contact />
  </main>
  <SiteFooter />
  {features.sideNav && <SideNav />}
  {features.backToTop && <BackToTop />}
</Base>
