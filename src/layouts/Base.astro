---
import { site, SITE_URL } from '../content/site';
import { reels } from '../content/reels';
import { bio } from '../content/bio';
import { heroPhoto } from '../content/gallery';
import displayFont from '../../node_modules/@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';

const title = 'Nelson Taffarel — Actor, comediante y locutor | Sitio oficial';
const ogTitle = 'Nelson Taffarel — Actor, comediante y locutor';
const description = site.description; // TODO-CONTENIDO
const url = `${SITE_URL}/`;
const ogImage = `${SITE_URL}/og-nelson-taffarel.jpg`;
const sameAs = [site.links.instagram, site.links.vimeo];

const person = {
  '@type': 'Person',
  '@id': `${url}#nelson-taffarel`,
  name: site.name,
  givenName: 'Nelson',
  familyName: 'Taffarel',
  jobTitle: [...site.roles],
  nationality: { '@type': 'Country', name: 'AR' },
  image: ogImage,
  url,
  sameAs,
  description,
  knowsAbout: ['Actuación', 'Danza', 'Equitación', 'Rugby', 'Golf', 'Ashtanga Yoga'],
  alumniOf: { '@type': 'EducationalOrganization', name: 'Taller de arte dramático de Agustín Alezzo' },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    { '@type': 'WebSite', '@id': `${url}#website`, name: site.name, url, inLanguage: 'es-AR', publisher: { '@id': person['@id'] } },
    {
      '@type': 'ProfilePage',
      '@id': `${url}#profile`,
      url,
      name: ogTitle,
      inLanguage: 'es-AR',
      isPartOf: { '@id': `${url}#website` },
      mainEntity: { '@id': person['@id'] },
    },
    ...reels.map((r) => ({
      '@type': 'VideoObject',
      name: `${site.name} — ${r.title}`,
      // TODO-CONTENIDO: descripción real de cada reel
      description: `${r.title} de ${site.name}, actor, comediante y locutor.`,
      thumbnailUrl: `https://i.ytimg.com/vi/${r.id}/hqdefault.jpg`,
      embedUrl: `https://www.youtube-nocookie.com/embed/${r.id}`,
      contentUrl: `https://www.youtube.com/watch?v=${r.id}`,
      uploadDate: r.uploadDate, // TODO-CONTENIDO
      actor: { '@id': person['@id'] },
    })),
  ],
};
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={heroPhoto.alt} />
    <meta property="profile:first_name" content="Nelson" />
    <meta property="profile:last_name" content="Taffarel" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0f0e0c" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!--
      THESIS: el sitio se lee como la secuencia de títulos de una película y su press kit; rechaza el portfolio-template centrado con cards, carrusel y violeta.
      OWN-WORLD: negro cálido de sala (#0f0e0c), hueso (#ece5d8), un solo rojo telón; Archivo condensada (wdth) en mayúsculas para nombre y créditos, Public Sans para cuerpo; listas con filetes finos, sin cards ni sombras.
      STORY: el visitante confirma quién es (h1 enorme), lee la trayectoria como créditos, ve el trabajo (galería, reels) y llega a Instagram/Vimeo.
      FIRST VIEWPORT: retrato B/N a la derecha (desktop) o a sangre (mobile) con viñeta; "Nelson / Taffarel" en display gigante abajo a la izquierda; roles en versalitas y CTA "Conóceme" subrayado en rojo.
      FORM: créditos de cine + press kit, dirección pinneada por PLAN-REWORK-SEO.md §3 (sin sorteo de concept-seed).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <slot />
  </body>
</html>
